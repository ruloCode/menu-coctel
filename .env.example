# Supabase — persistencia de las inscripciones del Concurso MG1
# Project Settings > API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (equivalente a la anon key). Puede ser publica:
# la tabla mg1_inscripciones solo le permite INSERT, nunca SELECT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRETO — opcional. Con esta key el route handler hace bypass de RLS y deja
# de depender de las policies. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
